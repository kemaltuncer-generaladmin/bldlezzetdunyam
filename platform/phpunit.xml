<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
        <!--
            Kendi kodumuz `extensions/veykemtu` altında yaşıyor (ADR-02) ve
            testleri de orada. Bu satır olmadan phpunit onları HİÇ görmez:
            `php artisan test` yalnızca Laravel'in iki örnek testini koşar,
            yeşil döner ve sözleşme testlerimizin koşmadığı fark edilmez.
        -->
        <testsuite name="Veykemtu">
            <directory suffix="Test.php">./extensions/veykemtu/*/tests</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!--
            AYRI TEST VERİTABANI ŞART.
            Bu satır yokken `php artisan test`, `.env`deki veritabanına
            bağlanıyordu ve `RefreshDatabase` GELİŞTİRME VERİTABANINI
            SİLİYORDU. Sahada yaşandı: yerel `bld` 85 tablodan 5'e düştü.
            SQLite kullanılamıyor — TastyIgniter göçleri MySQL'e özgü
            ifadeler içeriyor.
        -->
        <!--
            Test veritabanı BURADA AYARLANMAZ — `tests/bootstrap.php`
            içinde, Laravel açılmadan önce zorlanır. PHPUnit'in `<env>`
            girdisi ortamda zaten tanımlı bir değişkeni ezmiyor
            (konteyner `DB_DATABASE=bld` veriyor) ve `force="true"` de
            işe yaramıyor, çünkü bu yapılandırma eski şemaya göre
            doğrulanıyor ve öznitelik sessizce yok sayılıyor. Gerekçenin
            tamamı o dosyada.
        -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
