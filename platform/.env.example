# APP CONFIG (DO NOT REMOVE!)
APP_NAME=
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

IGNITER_CARTE_KEY=
IGNITER_LOCATION_MODE=multiple

# DATABASE CONFIG (DO NOT REMOVE!)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@tastyigniter.tld
MAIL_FROM_NAME="${APP_NAME}"
# ── FCM (veykemtu/push) ──────────────────────────────────────────────────
# Servis hesabı JSON dosyası repoya GİRMEZ; yol dışarıdan bağlanır.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json

# ── Müşteri sitesinin adresi ─────────────────────────────────────────────
# Ödeme sağlayıcısından dönüşte müşterinin gönderileceği yer ve fişlerdeki
# QR bağlantılarının kökü.
#
# TANIMSIZ BIRAKILIRSA ÖDEME DÖNÜŞÜ KIRILIR: `SimulationController` ve
# `AccountSimulationController` açık yönlendirme açığına karşı yalnızca BU
# adrese dönmeye izin veriyor. Boşken istemcinin gönderdiği `?return=`
# tamamen yok sayılıyor ve müşteri API köküne düşüyor — orası da ana
# domaine yönlendiği için "ödedim mi?" sorusuyla ana sayfada kalıyor.
#
# Fiş QR'ları da buradan üretiliyor (K-18): sipariş takip ve ödeme
# bağlantıları. Boşken QR hiç basılmaz — çalışmayan bir kare basmaktansa
# hiç basmamak doğrusu.
FRONTEND_URL=https://benimlezzetdunyam.com.tr

# ── Netgsm SMS — telefonla giriş kodu (B-18) ─────────────────────────────
# Kurumsal müşteri her sipariş için şifre hatırlamasın diye: telefon yaz,
# gelen kodu gir. E-posta + şifre yolu kapanmıyor; bu ikinci bir kapı.
#
# ÜÇÜ BİRDEN DOLU DEĞİLSE SMS GÖNDERİLMEZ ve kod yalnızca `storage/logs`
# içine `warning` seviyesinde yazılır. Uygulama ayağa kalkmaya devam eder —
# tek eksik değişken yüzünden bütün siteyi indirmek doğru olmazdı — ama
# hiçbir müşteri kod alamaz. Yayına çıkmadan önce doldurulmalı.
#
# `NETGSM_HEADER`, Netgsm panelinde ONAYLI gönderici adıdır. Onaysız bir
# başlıkla gönderim `40` hatası döner ve tek mesaj bile ulaşmaz.
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=

# ── Sanal POS (veykemtu/payment) ─────────────────────────────────────────
# Kuveyt Türk. Faz 1'de KAPALI — sağlayıcı sözleşmesi bekleniyor
# (BILINMEYENLER KOL-A). Anahtarlar asla repoya girmez.
POS_PROVIDER=kuveytturk
POS_MERCHANT_ID=
POS_CUSTOMER_ID=
POS_USERNAME=
POS_PASSWORD=
POS_TEST_MODE=true

# ── Reverb (Faz 1.5) ─────────────────────────────────────────────────────
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080

# ── Kurumsal site tazeleme ───────────────────────────────────────────────────
# İçerik panelde kaydedildiğinde siteye "önbelleğini tazele" isteği gider.
# Boş bırakılırsa istek hiç gönderilmez ve site içeriği kendi ISR süresi
# dolduğunda (5 dk) toparlar — veri kaybı olmaz, yalnızca gecikme olur.
# Sır, website tarafındaki CONTENT_REVALIDATE_SECRET ile AYNI olmalı.
SITE_REVALIDATE_URL=
SITE_REVALIDATE_SECRET=

# ── BBD Store köprüsü (K-16) ─────────────────────────────────────────────────
# BBD Store ayrı bir sunucudaki ayrı bir projedir. Tek bağ: oradaki sipariş
# mutfaktaki hoparlörden ses çalar ve termal yazıcıdan fiş bastırır. BLD'nin
# `orders` tablosuna, ciro raporuna ve cari hesaba KARIŞMAZ.
#
# İki taraf da AYNI sırrı kullanır. BOŞ BIRAKILIRSA uç kapalıdır ve her
# istek 401 döner — boş sırla imza doğrulamak, herkesin geçebildiği bir
# kapı demek olurdu.
#
# Üretmek için:  openssl rand -hex 32
BBD_WEBHOOK_SECRET=

# ── İade sürücüsü (K-13) ─────────────────────────────────────────────────────
# Yalnız `online` ödemeli siparişler için geçerli; `account` cari deftere,
# `cash` manuel iadeye gider. Gerçek sanal POS bağlanınca buraya onun adı
# yazılacak.
#   simulated — simülasyon (üretimde POS_ALLOW_SIMULATION olmadan çalışmaz)
#   manual    — yazılım iade yapmaz, kayıt açar ve insan tamamlar
BLD_REFUND_DRIVER=simulated
