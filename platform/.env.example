# platform/.env örneği — TastyIgniter (docs/04-platform.md §1).
#
# GERÇEK DEĞERLER ASLA COMMİTLENMEZ (AGENTS.md §2.2).
# Kurulum: B-01 görevinde `composer create-project` sonrası bu dosya
# `platform/.env` olarak kopyalanır ve `php artisan key:generate` koşulur.

APP_NAME="Benim Lezzet Dünyam"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr

# ── Veritabanı ───────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bld
DB_USERNAME=bld
DB_PASSWORD=

# ── İstemciler ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ── FCM (veykemtu/push) ──────────────────────────────────────────────────
# Servis hesabı JSON dosyası repoya GİRMEZ; yol dışarıdan bağlanır.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json

# ── Netgsm SMS (veykemtu/sms) ────────────────────────────────────────────
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=

# ── Sanal POS (veykemtu/payment) ─────────────────────────────────────────
# Kuveyt Türk. Faz 1'de KAPALI — sağlayıcı sözleşmesi bekleniyor
# (BILINMEYENLER KOL-A). Anahtarlar asla repoya girmez.
POS_PROVIDER=kuveytturk
POS_MERCHANT_ID=
POS_CUSTOMER_ID=
POS_USERNAME=
POS_PASSWORD=
POS_TEST_MODE=true

# ── Reverb (Faz 1.5) ─────────────────────────────────────────────────────
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
