# APP CONFIG (DO NOT REMOVE!)
APP_NAME=
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

IGNITER_CARTE_KEY=
IGNITER_LOCATION_MODE=multiple

# DATABASE CONFIG (DO NOT REMOVE!)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@tastyigniter.tld
MAIL_FROM_NAME="${APP_NAME}"
# ── FCM (veykemtu/push) ──────────────────────────────────────────────────
# Servis hesabı JSON dosyası repoya GİRMEZ; yol dışarıdan bağlanır.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json

# ── Netgsm SMS (veykemtu/sms) ────────────────────────────────────────────
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=

# ── Sanal POS (veykemtu/payment) ─────────────────────────────────────────
# Kuveyt Türk. Faz 1'de KAPALI — sağlayıcı sözleşmesi bekleniyor
# (BILINMEYENLER KOL-A). Anahtarlar asla repoya girmez.
POS_PROVIDER=kuveytturk
POS_MERCHANT_ID=
POS_CUSTOMER_ID=
POS_USERNAME=
POS_PASSWORD=
POS_TEST_MODE=true

# ── Reverb (Faz 1.5) ─────────────────────────────────────────────────────
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080

# ── Kurumsal site tazeleme ───────────────────────────────────────────────────
# İçerik panelde kaydedildiğinde siteye "önbelleğini tazele" isteği gider.
# Boş bırakılırsa istek hiç gönderilmez ve site içeriği kendi ISR süresi
# dolduğunda (5 dk) toparlar — veri kaybı olmaz, yalnızca gecikme olur.
# Sır, website tarafındaki CONTENT_REVALIDATE_SECRET ile AYNI olmalı.
SITE_REVALIDATE_URL=
SITE_REVALIDATE_SECRET=
