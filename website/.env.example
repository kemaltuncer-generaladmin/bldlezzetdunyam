# website/.env.local örneği (docs/06-website.md §6).
#
# Bu dosyada SIR YOKTUR — NEXT_PUBLIC_* değerleri tarayıcıya gider.
# Ödeme sağlayıcı anahtarları yalnızca platform/ tarafındadır.

# Geliştirmede ayaktaki gerçek platforma bağlanın (infra/docker-compose.dev.yml).
#
# Mock'a (prism, :4010) BAĞLANMAYIN: sözleşme testleri için var, `/site-content`
# gibi uçları hiç sunmuyor ve site sessizce yedek içeriğe düşüyor — ekranda her
# şey dolu göründüğü için fark etmesi zor.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Üretimde:
#   NEXT_PUBLIC_API_URL=https://api.benimlezzetdunyam.com.tr/api
#   NEXT_PUBLIC_SITE_URL=https://www.benimlezzetdunyam.com.tr

# Menü sayfası ISR önbelleği (saniye) — docs/06 §7
REVALIDATE_SECONDS=60

# TAZE OKUMALARIN MİKRO-ÖNBELLEK PENCERESİ (milisaniye).
#
# Sipariş kararı veren yollar vitrini ve günün menüsünü `no-store` okuyor.
# Bu, Next.js'in istek belleklemesini de kapattığı için tek bir "sepete ekle"
# tıklaması platforma on iki ayrı istek doğuruyordu (gerekçe ve ölçüm
# `lib/api/fresh-cache.ts`). Bu pencere o yığını ikiye indiriyor.
#
# ISR'nin 60 saniyesiyle KARIŞTIRILMAMALI: burada eskiyen şey yalnız EKRAN.
# Sipariş kabul kararını sunucu her hâlükârda yeniden veriyor
# (`LocationGate::assertAcceptsOrder`, `DailyMenuService::assertOrderable`).
#
# `0` yazmak katmanı kapatır (eş zamanlı istekleri birleştiren tek-uçuş
# davranışı yine kalır). Tanımsız bırakılırsa 2000 kullanılır.
CATALOG_FRESH_TTL_MS=2000

# Teklif formunun gönderileceği HTTP hedefi (app/actions/quote.ts).
#
# TANIMSIZ BIRAKILIRSA form kullanıcıya talebin iletilemediğini açıkça söyler
# ve sahte bir başarı mesajı GÖSTERMEZ. Talep sunucu günlüğüne yazılır.
#
# Bir e-posta servisi, form toplayıcı veya ileride yazılacak kendi uç
# noktamız olabilir; JSON gövde POST edilir. Sır içermemeli — içeriyorsa
# NEXT_PUBLIC_ öneki OLMADAN yalnızca sunucuda okunur (burada olduğu gibi).
QUOTE_WEBHOOK_URL=https://api.benimlezzetdunyam.com.tr/api/quote-requests

# Admin panelinden önbellek tazeleme ucunun paylaşılan sırrı
# (app/api/icerik-tazele/route.ts).
#
# Panelde "kaydet"e basıldığında panel bu adrese POST atar; site de ilgili
# önbelleği anında düşürür. Böylece değişiklik ISR penceresini beklemeden
# yayına girer.
#
# SÖZLEŞME (platform tarafıyla ortak):
#   POST  {SITE_REVALIDATE_URL}
#   Authorization: Bearer {SITE_REVALIDATE_SECRET}
#   {"tag": "daily-menu"}
#
# Kabul edilen etiketler: site-content (varsayılan), catalog, daily-menu.
# Gövde göndermeyen eski çağrılar `site-content` sayılır.
#
# BURADAKİ DEĞER, platformdaki SITE_REVALIDATE_SECRET İLE AYNI OLMALI —
# iki tarafın aynı sırra verdiği iki ad. Farklı olurlarsa uç 401 döner ve
# panelde hiçbir hata görünmez (tetikleme "en iyi çaba" olarak yutuluyor).
#
# TANIMSIZ BIRAKILIRSA uç tamamen kapalıdır (503) — boş sırla herkesin
# önbelleği sürekli boşaltmasına izin vermiyoruz. Bu durumda içerik yine
# güncellenir, sadece en geç 5 dakika gecikmeyle.
#
# SIR: NEXT_PUBLIC_ öneki YOKTUR, yalnızca sunucuda okunur. Gerçek değeri
# repoya girmez; üretimde uzun ve rastgele bir dize kullanın.
CONTENT_REVALIDATE_SECRET=
