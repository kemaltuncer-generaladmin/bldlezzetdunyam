# infra/.env örneği — `cp infra/.env.example infra/.env` ile kopyalayın.
#
# GERÇEK DEĞERLER ASLA COMMİTLENMEZ (AGENTS.md §2.2). .gitignore .env'i tutar.

# ── Portlar (geliştirme) ─────────────────────────────────────────────────
MOCK_PORT=4010
WEB_PORT=8080
DB_PORT=3306

# ── Veritabanı ───────────────────────────────────────────────────────────
DB_DATABASE=bld
DB_USERNAME=bld
DB_PASSWORD=degistir-beni
DB_ROOT_PASSWORD=degistir-beni-de

# ── Alan adları (üretim) ─────────────────────────────────────────────────
# Caddy hem {$DOMAIN} hem www.{$DOMAIN} için sertifika alır (infra/Caddyfile).
#
# TLS'in çalışması için şu A kayıtları 62.238.102.197'ye bakmalı:
#   @    A  62.238.102.197
#   www  A  62.238.102.197
#   api  A  62.238.102.197
# Kayıtlar yayılmadan `docker compose up` çalıştırılırsa Caddy sertifika
# alamaz ve sürekli yeniden dener.
DOMAIN=benimlezzetdunyam.com.tr
API_DOMAIN=api.benimlezzetdunyam.com.tr

# ── Bind mount sahiplik hizalaması ───────────────────────────────────────
# php-fpm bu UID ile koşar; host kullanıcınızla aynı olmalı (id -u / id -g).
# Uyuşmazsa web isteği storage/logs'a yazamaz ve her sayfa 500 döner.
UID=1000
GID=1000
