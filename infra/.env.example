# infra/.env örneği — `cp infra/.env.example infra/.env` ile kopyalayın.
#
# GERÇEK DEĞERLER ASLA COMMİTLENMEZ (AGENTS.md §2.2). .gitignore .env'i tutar.

# ── Portlar (geliştirme) ─────────────────────────────────────────────────
MOCK_PORT=4010
WEB_PORT=8080
DB_PORT=3306

# ── Veritabanı ───────────────────────────────────────────────────────────
DB_DATABASE=bld
DB_USERNAME=bld
DB_PASSWORD=degistir-beni
DB_ROOT_PASSWORD=degistir-beni-de

# ── Alan adları (üretim) ─────────────────────────────────────────────────
# Henüz kesin değil — BILINMEYENLER KOL-D
DOMAIN=bld.example.com
API_DOMAIN=api.bld.example.com
