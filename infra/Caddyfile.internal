# Coolify dağıtımında Caddy YALNIZCA iç FastCGI önyüzüdür.
#
# TLS, alan adı ve yönlendirme Coolify'ın Traefik'inde. Caddy dışarı port
# açmaz; Traefik ona `coolify` ağı üzerinden 80'den ulaşır. Traefik
# FastCGI konuşamadığı için php-fpm'in önünde bir HTTP sunucusu şart.
:80 {
	root * /var/www/platform/public

	# Medya dosyaları köken kısıtı olmadan sunulur — `Caddyfile.dev` ile
	# aynı kural, aynı gerekçe.
	#
	# NEDEN: `/storage/media/...` altındaki ürün fotoğrafları zaten herkese
	# açık statik içerik; API `image_url` ile bu adresi mutlak döndürüyor.
	# Tarayıcıda çalışan istemci (Flutter web) görseli `<img>` ile değil
	# fetch ile alıyor ve CORS başlığı yoksa menü fotoğrafsız açılıyor.
	#
	# Kural geliştirmede vardı, ÜRETİMDE YOKTU: iki dosya ayrışmıştı ve fark
	# yalnızca tarayıcıdan bakınca görünüyordu. Android/iOS CORS uygulamadığı
	# için mobil uygulamada hiçbir belirti yok; site de görselleri sunucu
	# tarafında çektiği için etkilenmiyor.
	#
	# Kimlik gerektiren hiçbir şey bu yolun altında değil.
	@medya path /storage/*
	header @medya Access-Control-Allow-Origin "*"

	# api.* KÖKÜ ANA DOMAINE GİDER (I-07).
	#
	# Bu konteyner yalnızca API + admin panelidir. Vitrin rotaları eklenti
	# tarafında kapatıldı (`BridgeApi\Extension::disableStorefrontTheme`), ama
	# oraya yazılan bir adres yine de 404 dönerdi. api.* adresini elle yazan
	# ya da eski bağlantıdan gelen müşteri boş sayfa değil gerçek siteyi
	# görmeli.
	#
	# İKİ KEMER, BİLEREK: eklenti bayrağı rotayı hiç kurmaz, bu kural ise
	# kurulsa bile dışarı sızmasını engeller. Biri geri alınırsa diğeri
	# tutar.
	#
	# `not` listesi tam olmak zorunda — buradan düşen her yol yönlendirilir:
	#   /api/*             REST sözleşmesi (docs/openapi.yaml)
	#   /admin*            yönetim paneli
	#   /storage/*         yüklenen medya (ürün fotoğrafları)
	#   /vendor/*          yayınlanan çekirdek varlıkları (CSS, ikon fontu)
	#   /_assets/*         çekirdeğin varlık birleştiricisi
	#   /odeme-simulasyon/* sipariş ödemesi simülasyonu (veykemtu.payment)
	#   /abonelik-odeme-simulasyon/* abonelik dönem ödemesi simülasyonu
	#   /cari-odeme-simulasyon/* cari borç ödemesi — ROTA ARTIK YOK (cari
	#                      hesap iş modelinden çıktı). Satır bilerek duruyor:
	#                      aşağıdaki dersin kanıtı ve eşleşse bile 404 döner.
	#   /teslimat/*        kuryenin fişteki QR'la açtığı teslim onayı (K-20)
	#   /sozlesme/*        abonenin SMS'teki bağlantıyla açtığı sözleşme onayı
	#   /abonelik-odemesi/* sanal POS'un aboneyi geri bıraktığı sonuç/iptal
	#   /robots.txt, /favicon.svg  kökte duran statik dosyalar
	#
	# BU LİSTE ÜÇ KEZ EKSİK KALDI; üçünde de arıza YALNIZ üretimde, YALNIZ
	# gerçek müşteride göründü. Geliştirmede `Caddyfile.dev` bu yönlendirmeyi
	# hiç kurmadığı için her şey çalışıyor gibi durur.
	#
	# 1) `/cari-odeme-simulasyon/*` eksikti, sayfa ana siteye yönleniyordu
	#    (14.08.2026). `path` ÖNEKTEN eşleşir: `/odeme-simulasyon/*` onu
	#    kapsamaz, çünkü adres o önekle BAŞLAMIYOR. Aynı tuzak
	#    `/abonelik-odeme-simulasyon/*` için de geçerli — ayrı satır şart.
	# 2) `/sozlesme/*` ve `/abonelik-odemesi/*` abonelik dalgasıyla geldi ve
	#    yine listeye yazılmadı. İkisinin de istemcisi yok: birini abone
	#    SMS'teki bağlantıdan, diğerini sanal POS geri yönlendirmeyle açıyor.
	#    Yönlendirilselerdi abone sözleşmesini hiç onaylayamaz, ödeme dönüşü
	#    sessizce kaybolurdu.
	#
	# TEK KAYNAK: `extensions/veykemtu/bridgeapi/routes/web.php` ile
	# `extensions/veykemtu/payment/src/Extension.php`. Oralara sunucuda
	# çizilen yeni bir sayfa eklendiğinde BURASI DA GÜNCELLENİR — ayrışma ne
	# testte ne açılışta görünür.
	@vitrinDisi {
		not path /api/* /admin /admin/* /storage/* /vendor/* /_assets/* /odeme-simulasyon/* /abonelik-odeme-simulasyon/* /cari-odeme-simulasyon/* /teslimat/* /sozlesme/* /abonelik-odemesi/* /robots.txt /favicon.svg
	}
	# Hedef ortamdan okunur; varsayılan üretim adresidir. Geliştirmede
	# `SITE_PUBLIC_URL` verilerek yerel siteye yönlendirilebilir.
	redir @vitrinDisi {$SITE_PUBLIC_URL:https://benimlezzetdunyam.com.tr}{uri} permanent

	php_fastcgi app:9000
	file_server
	encode gzip

	# Traefik zaten X-Forwarded-* gönderiyor; Laravel'in doğru şemayı
	# görmesi için (yönlendirmeler ve üretilen bağlantılar https olmalı).
	header {
		-Server
	}

	log {
		output stdout
		format console
	}
}
