# Caddy önyüzü — statik dosyalar uygulama imajından kopyalanır.
#
# NEDEN ÇOK AŞAMALI, NEDEN PAYLAŞILAN BİRİM DEĞİL:
# `platform/public/vendor/*` composer'ın yayınladığı varlıklardır; repoda
# durmazlar, derleme anında oluşurlar. Bunları `app` ile `web` arasında
# adsız birimle paylaşmak işe yarar gibi görünür ama birim ilk oluşumdan
# sonra güncellenmez — yeni sürüm dağıtıldığında Caddy ESKİ varlıkları
# sunmaya devam eder ve admin paneli kırık CSS ile açılır. Teşhisi zor,
# sebebi görünmez bir hata.
#
# İki aşama aynı katmanları kullanır; BuildKit önbelleği sayesinde ikinci
# derleme neredeyse bedavadır.

FROM php:8.3-fpm-bookworm AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl unzip ca-certificates libicu-dev libzip-dev libonig-dev \
      libfreetype6-dev libjpeg62-turbo-dev libpng-dev \
 && docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install -j"$(nproc)" pdo_mysql gd zip bcmath intl exif \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/platform

COPY platform/composer.json platform/composer.lock ./
RUN composer install --no-interaction --prefer-dist --no-progress \
      --no-dev --no-scripts --no-autoloader

COPY platform/ ./
RUN composer dump-autoload --optimize --no-dev

FROM caddy:2-alpine

COPY --from=build /var/www/platform/public /var/www/platform/public

# Yüklenen medyanın sunulabilmesi için `public/storage` bağlantısı.
#
# NEDEN İMAJDA: `php artisan storage:link` YALNIZCA `app` konteynerinin
# giriş betiğinde koşuyor ve bağlantıyı orada kuruyor. Bu imajın `public/`
# klasörü ise derleme aşamasından gelen ayrı bir kopya — o bağlantı buraya
# hiç ulaşmıyordu. Sonuç: menü fotoğrafları `image_url` ile duyuruluyor ama
# `/storage/media/...` isteği 404 dönüyordu.
#
# Bağlantı `storage/app/public` hedefini gösteriyor; dosyaların gerçekten
# görünmesi için `platform-storage` birimi bu konteynere de bağlanmalı
# (bkz. docker-compose.coolify.yml `web.volumes`). İkisi birlikte gerekli:
# yalnızca bağlantı kırık hedefe, yalnızca birim ise ulaşılamayan yola
# işaret eder.
RUN ln -s ../storage/app/public /var/www/platform/public/storage

# Yapılandırma imaja GÖMÜLÜR, bind mount edilmez.
#
# NEDEN: Coolify repo kaynağını uygulama dizininde tutmaz — derleme ayrı
# bir konteynerde yapılır ve kaynak atılır; geriye yalnızca .env ve
# çözümlenmiş docker-compose.yaml kalır. `./infra/Caddyfile.internal`
# gibi bir bind mount kaynağı bulamaz, Docker oraya boş bir KLASÖR
# oluşturur ve konteyner "not a directory" ile hiç başlamaz.
#
# Yapılandırmayı imaja gömmek zaten daha doğru: sunulan dosyalarla onları
# sunan yapılandırma aynı yapıda, birlikte sürümleniyor.
COPY infra/Caddyfile.internal /etc/caddy/Caddyfile
