#!/bin/sh
# Kasa paketinin kurulum sonrası adımı — YALNIZCA ROOT GEREKTİREN İŞLER.
#
# Uygulamanın kurulumu, ekran ayarları ve servis burada DEĞİL: onlar
# `kasa-ayarla` içinde, kullanıcı oturumunda koşuyor. Gerekçesi o dosyanın
# başlığında — kısaca root'un ev dizinine yazdığı dosyalar root'a ait olur
# ve uzaktan güncellemeyi bozar.
set -e

[ "$1" = "configure" ] || exit 0

# ── Kasa kullanıcısını bul ───────────────────────────────────────────────
#
# Otomatik giriş için bir kullanıcı adı gerekiyor ve paket bunu bilemez.
# Üç kaynağı sırayla deniyoruz; hiçbiri tutmazsa otomatik giriş ATLANIR ve
# ekrana ne yapılacağı yazılır. Yanlış kullanıcıyı otomatik girişe açmak,
# sessizce yanlış bir masaüstü açmaktan daha kötü olurdu.
KASA_KULLANICI=""
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    KASA_KULLANICI="$SUDO_USER"
elif [ -n "${PKEXEC_UID:-}" ]; then
    KASA_KULLANICI="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
else
    # Tek masaüstü kullanıcısı varsa o. Birden fazlaysa seçim yapmıyoruz.
    SAYI="$(getent passwd | awk -F: '$3>=1000 && $3<65534 {print $1}' | wc -l)"
    [ "$SAYI" = "1" ] && KASA_KULLANICI="$(getent passwd | awk -F: '$3>=1000 && $3<65534 {print $1}')"
fi

# ── 1. Hazırlık servisini tüm oturumlar için aç ──────────────────────────
#
# `--global`: /etc/systemd/user/ altındaki birimi her kullanıcı oturumu için
# etkinleştirir. Kasa tek kullanıcılı ama bu yol, kullanıcı adını bilmeyi
# gerektirmediği için daha sağlam.
systemctl --global enable mutfakapp-kurulum.service >/dev/null 2>&1 || true

# ── 2. Yazıcı kuralı ─────────────────────────────────────────────────────
if [ -d /run/udev ]; then
    udevadm control --reload-rules >/dev/null 2>&1 || true
    udevadm trigger >/dev/null 2>&1 || true
fi

# ── 3. Otomatik giriş ────────────────────────────────────────────────────
#
# Elektrik gelince parola bekleyen bir ekran, mutfağın körleşmesi demek.
GDM=/etc/gdm3/custom.conf
if [ -n "$KASA_KULLANICI" ] && [ -f "$GDM" ]; then
    if grep -qE '^\s*AutomaticLoginEnable\s*=\s*[Tt]rue' "$GDM"; then
        echo "mutfakapp: otomatik giriş zaten açık"
    else
        sed -i \
            -e "s/^#*\s*AutomaticLoginEnable\s*=.*/AutomaticLoginEnable=true/" \
            -e "s/^#*\s*AutomaticLogin\s*=.*/AutomaticLogin=$KASA_KULLANICI/" \
            "$GDM"
        if grep -qE '^AutomaticLoginEnable' "$GDM"; then
            echo "mutfakapp: otomatik giriş açıldı ($KASA_KULLANICI)"
        else
            echo "mutfakapp: UYARI — $GDM içine satır eklenemedi."
            echo "           [daemon] bölümüne elle ekleyin:"
            echo "             AutomaticLoginEnable=true"
            echo "             AutomaticLogin=$KASA_KULLANICI"
        fi
    fi
elif [ -z "$KASA_KULLANICI" ]; then
    echo "mutfakapp: UYARI — kasa kullanıcısı belirlenemedi, otomatik giriş atlandı."
    echo "           $GDM içinde [daemon] bölümüne elle ekleyin."
fi

# ── 4. Gece yarısı yeniden başlatmayı kapat ──────────────────────────────
#
# Gece 03:00'te kendini yeniden başlatan bir kasa, sabah servisinde kapalı
# ekran demektir.
UU=/etc/apt/apt.conf.d/50unattended-upgrades
if [ -f "$UU" ]; then
    sed -i 's|^//*\s*Unattended-Upgrade::Automatic-Reboot\s*".*";|Unattended-Upgrade::Automatic-Reboot "false";|' "$UU" || true
fi

cat <<'SON'

  ────────────────────────────────────────────────────────────
  Mutfak kasası kuruldu.

  ŞİMDİ YENİDEN BAŞLATIN.

  Açılışta otomatik giriş yapılacak ve uygulama tam ekran gelecek.
  İlk açılışta EŞLEME EKRANI çıkar; admin panelden aldığınız
  eşleme kodunu ve cihaz adını girin. Bir daha sorulmaz.
  ────────────────────────────────────────────────────────────

SON

exit 0
